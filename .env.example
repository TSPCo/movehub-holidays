# Postgres connection string (Railway provides this when you add a Postgres service)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random secret used to sign session cookies — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-value"

# Required in production behind a reverse proxy (Railway, etc.) — used to build invite
# and password-reset links. Without it, links are built from the request's own origin,
# which behind a proxy often resolves to an internal address instead of your public domain.
APP_URL="https://holidays.move-hub.co.uk"

# Staff sync with movehub-commissions — adding/disabling/deleting someone here
# also pushes that change there, and vice versa. Same secret must be set on
# both apps. Leaving either unset just disables the sync (no error).
PEER_APP_URL="https://commissions.move-hub.co.uk"
STAFF_SYNC_SECRET="replace-with-a-long-random-value-shared-with-movehub-commissions"

# Resend API key — enables emailing staff when their holiday request is approved/rejected.
# Without it, the app logs what it would have sent instead of erroring.
# RESEND_API_KEY="re_xxxxxxxx"

# Optional — the From address for those emails. Must be on a domain verified in Resend.
# EMAIL_FROM="Move Hub Holidays <holidays@move-hub.co.uk>"

# Optional — overrides the default seeded admin created by `npm run db:seed`
# SEED_ADMIN_EMAIL="admin@move-hub.co.uk"
# SEED_ADMIN_PASSWORD="changeme123"
